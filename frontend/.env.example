# URL do backend do Planejador Financeiro -- é ele quem recebe o intake
# (POST /api/v1/intake/lastro), a resolução de carteira e o resultado salvo.
# Localmente, aponte pro backend do Planejador Financeiro rodando (ver
# COMO_RODAR.md daquele projeto); sem essa variável, o dev server usa
# http://localhost:8000 como padrão (ver lib/planejador-api-url.ts).
#
# OBRIGATÓRIA em qualquer build de produção (next build, incl. Vercel Production
# e Preview) -- aponte pro domínio HTTPS real do Planejador. Sem ela, o build
# falha de propósito (TASK-033): o padrão localhost, embutido num bundle https,
# é bloqueado pelo navegador como conteúdo misto para qualquer visitante -- o
# app publicado carregaria mas não conseguiria falar com o Planejador.
NEXT_PUBLIC_PLANEJADOR_API_URL=http://localhost:8000

# Domínio público real desta própria página -- usado só em title/OG/Twitter
# card (metadataBase). Sem isso, os links de preview (WhatsApp etc.) usam
# localhost, que funciona em dev mas precisa virar o domínio real em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ANBIMA (server-side only -- NEVER use the public prefix on these names, and never
# import the AIE server boundary from client components). Leave the credentials
# empty to keep ANBIMA disabled. Put real values only in an untracked .env.local.
ANBIMA_CLIENT_ID=
ANBIMA_CLIENT_SECRET=
ANBIMA_ENVIRONMENT=production

# Identity introspection for the AIE routes (server-side only -- NEVER use the public
# prefix on this name). Base URL of the Planejador API that answers GET /api/v1/auth/me
# (https required; http only for localhost). Leave it empty and every AIE route denies
# all requests (fail closed).
PLANEJADOR_AUTH_BASE_URL=

# Durable AIE audit trail (TASK-037, server-side only -- NEVER use the public prefix on
# this name). Server-to-server secret sent as X-Aie-Audit-Secret to the Planejador's
# POST /api/v1/aie-audit-events (same base URL as PLANEJADOR_AUTH_BASE_URL above). Leave
# it empty and the AIE routes keep working normally, but no audit event is durably
# stored (auditing is best-effort and never affects an authorization decision).
AIE_AUDIT_SHARED_SECRET=
