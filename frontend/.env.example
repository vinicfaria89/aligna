# URL do backend do Planejador Financeiro -- é ele quem recebe o intake
# (POST /api/v1/intake/lastro) no fim do fluxo. Localmente, aponte pro
# backend do Planejador Financeiro rodando (ver COMO_RODAR.md daquele
# projeto). Em produção, aponte pro domínio real dele.
NEXT_PUBLIC_PLANEJADOR_API_URL=http://localhost:8000

# Domínio público real desta própria página -- usado só em title/OG/Twitter
# card (metadataBase). Sem isso, os links de preview (WhatsApp etc.) usam
# localhost, que funciona em dev mas precisa virar o domínio real em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ANBIMA (server-side only -- NEVER use the public prefix on these names, and never
# import the AIE server boundary from client components). Leave the credentials
# empty to keep ANBIMA disabled. Put real values only in an untracked .env.local.
ANBIMA_CLIENT_ID=
ANBIMA_CLIENT_SECRET=
ANBIMA_ENVIRONMENT=production

# Identity introspection for the AIE routes (server-side only -- NEVER use the public
# prefix on this name). Base URL of the Planejador API that answers GET /api/v1/auth/me
# (https required; http only for localhost). Leave it empty and every AIE route denies
# all requests (fail closed).
PLANEJADOR_AUTH_BASE_URL=
